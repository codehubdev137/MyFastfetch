{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logo.png",
        "type": "kitty",
        "height": 20,
        "padding": { "top": 1, "left": 2, "right": 3 }
    },
    "display": {
        "separator": ": ",
        "color": { "separator": "90" }
    },
    "modules": [
        "break",

        { "type": "custom", "format": "\u001b[1;33m┌─ System\u001b[0m" },
        { "type": "os",       "key": "\u001b[33m│\u001b[0m OS        ", "keyColor": "33" },
        { "type": "kernel",   "key": "\u001b[33m│\u001b[0m Kernel    ", "keyColor": "33" },
        { "type": "uptime",   "key": "\u001b[33m│\u001b[0m Uptime    ", "keyColor": "33" },
        { "type": "shell",    "key": "\u001b[33m│\u001b[0m Shell     ", "keyColor": "33" },
        { "type": "custom", "format": "\u001b[33m└──\u001b[0m" },

        "break",

        { "type": "custom", "format": "\u001b[1;32m┌─ Desktop\u001b[0m" },
        { "type": "wm",           "key": "\u001b[32m│\u001b[0m WM        ", "keyColor": "32" },
        { "type": "terminal",     "key": "\u001b[32m│\u001b[0m Terminal  ", "keyColor": "32" },
        { "type": "custom", "format": "\u001b[32m└──\u001b[0m" },

        "break",

        { "type": "custom", "format": "\u001b[1;36m┌─ Hardware\u001b[0m" },
        { "type": "host",    "key": "\u001b[36m│\u001b[0m Model     ", "keyColor": "36", "format": "{5} {1} ({2})" },
        { "type": "cpu",     "key": "\u001b[36m│\u001b[0m CPU       ", "keyColor": "36", "format": "{1} ({3}) @ {7}" },
        { "type": "gpu",     "key": "\u001b[36m│\u001b[0m GPU       ", "keyColor": "36", "format": "{2}" },
        { "type": "memory",  "key": "\u001b[36m│\u001b[0m RAM       ", "keyColor": "36" },
	{"type": "disk","key": "\u001b[36m│\u001b[0m Disk      ","keyColor": "36","format": "{1} / {2} ({3})"},
        { "type": "battery", "key": "\u001b[36m│\u001b[0m Battery   ", "keyColor": "36" },
        { "type": "custom", "format": "\u001b[36m└──\u001b[0m" },

        "break"
    ]
}
